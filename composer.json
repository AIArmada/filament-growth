{
  "name": "aiarmada/filament-growth",
  "description": "Filament admin package for the AIArmada growth experimentation engine",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "laravel",
    "filament",
    "growth",
    "experimentation"
  ],
  "authors": [
    {
      "name": "AIArmada",
      "email": "dev@aiarmada.com"
    }
  ],
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/growth": "self.version",
    "aiarmada/signals": "self.version",
    "filament/filament": "^5.11.1",
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\FilamentGrowth\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\FilamentGrowth\\FilamentGrowthServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  }
}
